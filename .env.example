# Deployer / Employer private key (without 0x prefix)
PRIVATE_KEY=

# Worker private key (used by worker_cli)
WORKER_PRIVATE_KEY=

# Employer private key (used by employer_sdk)
EMPLOYER_PRIVATE_KEY=

# Pinata JWT for IPFS uploads (worker_cli)
# Get one at https://app.pinata.cloud → API Keys → New Key → enable pinFileToIPFS
PINATA_JWT=

# Public URL of the x.402 key gateway (worker_cli)
# Use ngrok for remote access: ngrok http 5000
GATEWAY_PUBLIC_URL=http://127.0.0.1:5000

# Contract addresses (update after deployment)
INTENT_POOL_ADDRESS=0x1a8d74e1ADf1Be715e20d39ccF7637b8486b5899
AGENT_IDENTITY_ADDRESS=
